<?php

declare(strict_types=1);

/**
 * @file
 * Hooks for the Phoenix Estate module.
 */

/**
 * Implements hook_theme().
 */
function phoenix_estate_theme(): array {
  return [

    'phoenix_estate_collection' => [
  'variables' => [
    'estates' => [],
  ],
  'template' => 'phoenix-estate-collection',
],    

    'phoenix_estate_workspace' => [
      'variables' => [
        'estate_name' => '',
        'phoenix_code' => '',
        'lifecycle' => '',
        'block_count' => 0,
        'block_rows' => [],
      ],
      'template' => 'phoenix-estate-workspace',
    ],
  ];
}
