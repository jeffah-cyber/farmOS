<div class="phoenix-workspace">

  <header class="phoenix-workspace__header">
    <h1>{{ block_name }}</h1>

    <div class="phoenix-workspace__meta">
      <span>{{ phoenix_code }}</span>

      {{ include('@phoenix_core/components/status-badge.html.twig', {
        status: health,
        label: health
      }) }}
    </div>

    <p>Estate: {{ estate_name }}</p>
  </header>

  <section class="phoenix-workspace__kpis">

    {{ include('@phoenix_core/components/stat-card.html.twig', {
      title: 'Trees',
      value: tree_count,
      subtitle: 'Recorded palms'
    }) }}

    {{ include('@phoenix_core/components/stat-card.html.twig', {
      title: 'Area',
      value: area,
      subtitle: 'Plantation block area'
    }) }}

    {{ include('@phoenix_core/components/stat-card.html.twig', {
      title: 'Age',
      value: age,
      subtitle: 'Since planting'
    }) }}

    {{ include('@phoenix_core/components/stat-card.html.twig', {
      title: 'Health',
      value: health,
      subtitle: 'Current assessment'
    }) }}

  </section>

  <main class="phoenix-workspace__content">

    <section class="phoenix-dashboard__portfolio">
      <h2>Block Information</h2>

      <dl>
        <dt>Block Code</dt>
        <dd>{{ phoenix_code }}</dd>

        <dt>Estate</dt>
        <dd>{{ estate_name }}</dd>

        <dt>Area</dt>
        <dd>{{ area }}</dd>

        <dt>Tree Count</dt>
        <dd>{{ tree_count }}</dd>

        <dt>Planting Date</dt>
        <dd>{{ planting_date }}</dd>

        <dt>Age</dt>
        <dd>{{ age }}</dd>

        <dt>Planting Density</dt>
        <dd>{{ planting_density }}</dd>

        <dt>Health</dt>
        <dd>{{ health }}</dd>
      </dl>
    </section>

    <section class="phoenix-dashboard__portfolio">
      <h2>Recent Operations</h2>

      {% if record_operation_url %}
  <p>
    <a
      href="{{ record_operation_url }}"
      class="phoenix-action-button"
    >
      + Record Operation
    </a>
  </p>
{% endif %}

      {% if recent_activities %}

        <div class="phoenix-timeline">

          {% for activity in recent_activities %}

            <article class="phoenix-timeline__item">

              <div class="phoenix-timeline__marker"></div>

              <div class="phoenix-timeline__content">

                <h3>{{ activity.name }}</h3>

                <div class="phoenix-timeline__meta">
                  {{ activity.timestamp|date('d M Y, H:i') }}

                  {% if activity.status %}
                    · {{ activity.status|capitalize }}
                  {% endif %}
                </div>

                <a
                  href="/log/{{ activity.id }}"
                  class="phoenix-timeline__link"
                >
                  View operation →
                </a>

              </div>

            </article>

          {% endfor %}

        </div>

      {% else %}

        <p>No operations have been recorded for this block yet.</p>

      {% endif %}

    </section>

  </main>

  <aside class="phoenix-workspace__sidebar">

    <section>
      <h2>{{ 'Upcoming Tasks'|t }}</h2>
      {% if add_task_url %}
        <p><a href="{{ add_task_url }}" class="phoenix-action-button">{{ '+ Add Task'|t }}</a></p>
      {% endif %}
      {% if upcoming_tasks %}
        <ul>
          {% for task in upcoming_tasks %}
<li>
  <a href="{{ task.url }}">{{ task.name }}</a>

  <div>
    {{ 'Due'|t }}: {{ task.due_date }} · {{ task.status }}
  </div>

  {% if task.workers %}
    <div>
      <strong>{{ 'Workers'|t }}:</strong>
      {{ task.workers|join(', ') }}
    </div>
  {% endif %}

  {% if task.equipment %}
    <div>
      <strong>{{ 'Equipment'|t }}:</strong>
      {{ task.equipment|join(', ') }}
    </div>
  {% endif %}

  {% if task.edit_url %}
    <a href="{{ task.edit_url }}">
      {{ 'Edit task / status'|t }}
    </a>
  {% endif %}
</li>          {% endfor %}
        </ul>
      {% else %}
        <p>{{ 'No scheduled tasks.'|t }}</p>
      {% endif %}
    </section>

    <section>
      <h2>Alerts</h2>
      <p>No active alerts.</p>
    </section>

  </aside>

</div>
