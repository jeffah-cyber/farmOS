<?php

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\BubbleableMetadata;
use Drupal\log\Entity\LogInterface;

/**
 * @file
 * Hooks for the Phoenix Operations module.
 */

/**
 * Implements hook_theme().
 */
function phoenix_operations_theme(): array {
  return [
    'phoenix_operations_collection' => [
      'variables' => [
        'operations' => [],
        'record_operation_url' => '',
      ],
      'template' => 'phoenix-operations-collection',
    ],

    'phoenix_operation_workspace' => [
      'variables' => [
        'operation' => [],
        'edit_url' => '',
      ],
      'template' => 'phoenix-operation-workspace',
    ],
  ];
}

/**
 * Implements hook_farm_ui_theme_field_group_items().
 *
 * Places essential Activity fields in Phoenix-friendly form groups.
 */
function phoenix_operations_farm_ui_theme_field_group_items(
  string $entity_type,
  string $bundle,
): array {
  if ($entity_type !== 'log' || $bundle !== 'activity') {
    return [];
  }

  return [
    'category' => 'default',
  ];
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function phoenix_operations_form_log_activity_form_alter(
  array &$form,
  FormStateInterface $form_state,
): void {
  // Run Phoenix processing after farmOS/Gin processing has completed.
  $form['#process'][] = 'phoenix_operations_process_activity_form';
}

/**
 * Applies final Phoenix adjustments to Activity forms.
 */
function phoenix_operations_process_activity_form(
  array $form,
  FormStateInterface $form_state,
): array {
  if (isset($form['category'])) {
    $form['category']['#group'] = 'default_field_group';
    $form['category']['#weight'] = 5;
  }

  return $form;
}

/**
 * Implements hook_token_info().
 */
function phoenix_operations_token_info(): array {
  return [
    'tokens' => [
      'log' => [
        'phoenix-asset-name' => [
          'name' => t('Phoenix asset name'),
          'description' => t('The names of assets linked to the operation.'),
        ],
      ],
    ],
  ];
}

/**
 * Implements hook_tokens().
 */
function phoenix_operations_tokens(
  string $type,
  array $tokens,
  array $data,
  array $options,
  BubbleableMetadata $bubbleable_metadata,
): array {
  $replacements = [];

  if ($type !== 'log' || empty($data['log'])) {
    return $replacements;
  }

  $log = $data['log'];

  if (!$log instanceof LogInterface) {
    return $replacements;
  }

  foreach ($tokens as $name => $original) {
    if ($name !== 'phoenix-asset-name') {
      continue;
    }

    $asset_names = [];

    foreach ($log->get('asset')->referencedEntities() as $asset) {
      $asset_names[] = $asset->label();
      $bubbleable_metadata->addCacheableDependency($asset);
    }

    $replacements[$original] = implode(', ', $asset_names);
  }

  return $replacements;
}
