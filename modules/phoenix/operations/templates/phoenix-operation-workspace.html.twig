<div class="phoenix-workspace">

  <header class="phoenix-workspace__header">
    <h1>{{ operation.name }}</h1>

    <div class="phoenix-workspace__meta">
      {{ include('@phoenix_core/components/status-badge.html.twig', {
        status: operation.status,
        label: operation.status|capitalize
      }) }}
    </div>

    <p>{{ operation.timestamp|date('d M Y, H:i') }}</p>
  </header>

  <main class="phoenix-workspace__content">

    <section class="phoenix-dashboard__portfolio">
      <h2>Operation Details</h2>

      <dl>
        <dt>Status</dt>
        <dd>{{ operation.status|capitalize }}</dd>

        <dt>Category</dt>
        <dd>
          {% if operation.categories %}
            {{ operation.categories|join(', ') }}
          {% else %}
            —
          {% endif %}
        </dd>

        <dt>Date</dt>
        <dd>{{ operation.timestamp|date('d M Y, H:i') }}</dd>

        <dt>Plantation Block</dt>
        <dd>
          {% if operation.plantation_blocks %}
            {% for block in operation.plantation_blocks %}
              {{ block.name }}{% if not loop.last %}, {% endif %}
            {% endfor %}
          {% else %}
            —
          {% endif %}
        </dd>

        <dt>Workers</dt>
        <dd>
          {% if operation.workers %}
            {{ operation.workers|join(', ') }}
          {% else %}
            —
          {% endif %}
        </dd>

        <dt>Equipment</dt>
        <dd>
          {% if operation.equipment %}
            {% for item in operation.equipment %}
              {{ item.name }}{% if not loop.last %}, {% endif %}
            {% endfor %}
          {% else %}
            —
          {% endif %}
        </dd>

        {% if operation.assets %}
          <dt>Other Assets</dt>
          <dd>
            {% for asset in operation.assets %}
              {{ asset.name }}{% if not loop.last %}, {% endif %}
            {% endfor %}
          </dd>
        {% endif %}

        <dt>Movement</dt>
        <dd>{{ operation.is_movement ? 'Yes' : 'No' }}</dd>
      </dl>
    </section>

    <section class="phoenix-dashboard__portfolio">
      <h2>Notes</h2>

      {% if operation.notes %}
        <p>{{ operation.notes }}</p>
      {% else %}
        <p>No notes recorded.</p>
      {% endif %}
    </section>

  </main>

  <aside class="phoenix-workspace__sidebar">

    <section>
      <h2>Actions</h2>

      <a href="{{ edit_url }}" class="phoenix-action-button">
        Edit Operation
      </a>
    </section>

  </aside>

</div>
